[resource]
script = ExtResource("1_jdprw")
icon = ExtResource("1_6atyx")
label = "Brush"
tooltip = "The most basic of brushes that can simply elevate or lower terrain.

[b]Shortcuts[/b]:
[ul]LMB+Drag: Select cells (adds to the current selection).[/ul]

[ul]Shift+LMB+Drag: Raise or lower the selected cells.[/ul]

[ul]Shift+Alt+LMB+Drag: Raise or lower only the hovered cell.[/ul]

[ul]Ctrl+LMB+Drag: Deselect the cells under the brush.[/ul]

[ul]Alt: Deselect all cells.[/ul]

[ul]Shift+MWU/MWD: Increase or decrease the brush size (all brush based tools).[/ul]"
attributes = SubResource("Resource_f0ade")
metadata/_custom_type_script = "uid://brkjbcthwswel"
